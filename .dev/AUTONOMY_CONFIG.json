{
  "execution": {
    "mode": "unattended",
    "scope": "mvp-only",
    "releaseVersion": "0.1.0",
    "stopBefore": [
      "marketplace-publishing",
      "external-messages",
      "destructive-operations",
      "credential-use",
      "licensing-decisions",
      "material-scope-changes"
    ]
  },
  "product": {
    "releaseHost": "desktop-vscode",
    "forks": ["cursor", "windsurf"],
    "forkSupport": "best-effort-smoke-test",
    "includeDlc": false,
    "includeFullMapping": false,
    "gameplayBaseline": "vampire-survivors-base-game",
    "acceptedDivergences": ["token-battery", "gold-acquisition"],
    "releaseArtifact": "local-vsix"
  },
  "telemetry": {
    "firstImplementation": "synthetic-fixtures",
    "realAdapters": "stable-opt-in-only",
    "estimatedCountsMustBeLabeled": true,
    "rawContentRetention": false,
    "secretsAvailable": false
  },
  "resources": {
    "allowOnlineDependencyAndResourceDownloads": true,
    "onlineResearchAndProjectDownloads": "preapproved",
    "externalPublication": false
  },
  "assets": {
    "firstPass": "original-or-placeholder-assets",
    "licensedAssets": "defer-until-reviewed"
  },
  "quality": {
    "performanceBenchmarking": "not-required-for-mvp",
    "required": [
      "deterministic-tests",
      "clean-build",
      "resource-teardown",
      "bounded-queues-and-entity-counts",
      "security-and-privacy-checks",
      "real-boundary-test-or-recorded-manual-check",
      "source-verified-current-documentation"
    ]
  }
}
